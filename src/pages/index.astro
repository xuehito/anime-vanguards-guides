---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const cards = guides.map((g) => {
  const slug = g.id.replace(/\.mdx?$/, '');
  const href =
    slug === 'anime-vanguards'
      ? '/anime-vanguards/'
      : `/anime-vanguards/${slug.replace(/^anime-vanguards-/, '')}/`;
  return {
    href,
    title: g.data.label ?? g.data.title,
    description: g.data.description,
    tag: g.data.type,
  };
});
---

<BaseLayout
  title="Anime Vanguards Codes, Tier List & Guides"
  description="Fast English guides for Roblox Anime Vanguards — working codes, unit tier list, and beginner tips. Updated for the latest patch."
  wide
>
  <section class="hero prose">
    <h1>Anime Vanguards Guides</h1>
    <p>
      Unofficial English hub for <strong>Anime Vanguards</strong> on Roblox. Grab
      working codes, check the unit meta, and start strong — mobile-friendly and
      updated around major patches.
    </p>
  </section>

  <AdSlot slot="leaderboard" />

  <section class="card-grid" aria-label="Guides">
    {
      cards.map((c) => (
        <a class="card" href={c.href}>
          <h2>{c.title}</h2>
          <p>{c.description}</p>
          <span class="tag">{c.tag}</span>
        </a>
      ))
    }
  </section>

  <section class="prose" style="margin-top: 2.5rem">
    <h2>Why this site</h2>
    <ul>
      <li><strong>Codes first</strong> — copy buttons, level requirements, expired list</li>
      <li><strong>Clear tier guidance</strong> — investment priorities, not just a dump of names</li>
      <li><strong>Static & fast</strong> — built for quick checks between matches</li>
    </ul>
    <p class="callout">
      <strong>Not affiliated</strong> with Roblox or Anime Vanguards developers.
      Codes and meta change often — verify in-game when in doubt.
    </p>
  </section>
</BaseLayout>
