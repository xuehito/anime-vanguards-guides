---
import { getEntry, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import HubCategories from '../../components/HubCategories.astro';
import SummonPityCalculator from '../../components/SummonPityCalculator.astro';

const entry = await getEntry('guides', 'anime-vanguards');
if (!entry) throw new Error('Missing content: anime-vanguards');
const { Content } = await render(entry);
const { title, description, updated, type } = entry.data;
---

<GuideLayout title={title} description={description} updated={updated} type={type}>
  <HubCategories />
  <SummonPityCalculator compact id="hub-summon-pity" />
  <Content />
</GuideLayout>
