---
import { getEntry, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';

const entry = await getEntry('guides', 'anime-vanguards-evolve');
if (!entry) throw new Error('Missing content: anime-vanguards-evolve');
const { Content } = await render(entry);
const { title, description, updated, type } = entry.data;
---

<GuideLayout title={title} description={description} updated={updated} type={type}>
  <Content />
</GuideLayout>
