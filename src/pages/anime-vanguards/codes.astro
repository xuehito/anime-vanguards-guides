---
import { getEntry, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';

const entry = await getEntry('guides', 'anime-vanguards-codes');
if (!entry) throw new Error('Missing content: anime-vanguards-codes');
const { Content } = await render(entry);
const {
  title,
  description,
  updated,
  nextUpdate,
  type,
  patch,
  activeCodes,
  expiredCodes,
  archivedByUpdate,
} = entry.data;
---

<GuideLayout
  title={title}
  description={description}
  updated={updated}
  nextUpdate={nextUpdate}
  type={type}
  patch={patch}
  activeCodes={activeCodes}
  expiredCodes={expiredCodes}
  archivedByUpdate={archivedByUpdate}
>
  <Content />
</GuideLayout>
