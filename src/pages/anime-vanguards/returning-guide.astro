---
import { getEntry, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';

const entry = await getEntry('guides', 'anime-vanguards-returning-guide');
if (!entry) throw new Error('Missing content: anime-vanguards-returning-guide');
const { Content } = await render(entry);
const { title, description, updated, type, patch } = entry.data;
---

<GuideLayout
  title={title}
  description={description}
  updated={updated}
  type={type}
  patch={patch}
>
  <Content />
</GuideLayout>
