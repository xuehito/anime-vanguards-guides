---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { localeFromPath } from '../lib/url';
import { LOCALE_BCP47 } from '../i18n/routing';
import { getUi } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  pubDate: string;
  updated?: string;
  category?: string;
  tags?: string[];
}

const { title, description, pubDate, updated, category = 'Guide Notes', tags = [] } =
  Astro.props;

const locale = localeFromPath(Astro.url.pathname);
const ui = getUi(locale);
const dateLocale = LOCALE_BCP47[locale];

const publishedLabel = new Date(pubDate + 'T12:00:00').toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedLabel = updated
  ? new Date(updated + 'T12:00:00').toLocaleDateString(dateLocale, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate,
  dateModified: updated ?? pubDate,
  author: { '@type': 'Organization', name: 'AV Guides' },
  publisher: {
    '@type': 'Organization',
    name: 'AV Guides',
    url: 'https://animevanguards.co/',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).href,
  },
};
---

<BaseLayout title={title} description={description} type="article">
  <JsonLd data={articleLd} />

  <article class="prose blog-post">
    <header class="blog-post__header">
      <p class="eyebrow">
        <span class="badge badge--accent">{category}</span>
        <span class="badge">{ui.shared.published} {publishedLabel}</span>
        {updatedLabel && (
          <span class="badge badge--trust">
            {ui.shared.updated} {updatedLabel}
          </span>
        )}
      </p>
      <h1>{title}</h1>
      <p>{description}</p>
      {
        tags.length > 0 && (
          <ul class="blog-tags" aria-label="Post tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <slot />
  </article>
</BaseLayout>
