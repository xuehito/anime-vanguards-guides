---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import CodeTable from '../components/CodeTable.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import JsonLd from '../components/JsonLd.astro';
import SourceStrip from '../components/SourceStrip.astro';
import CodesArchive from '../components/CodesArchive.astro';
import Faq from '../components/Faq.astro';
import { FAQ_BY_TYPE } from '../data/faqs';
import { CODES_REFRESH_HOURS } from '../lib/next-update';
import { localeFromPath, localizePath } from '../lib/url';
import { LOCALE_BCP47, defaultLocale } from '../i18n/routing';
import { getUi } from '../i18n/ui';

interface CodeEntry {
  code: string;
  rewards: string;
  requirement?: string;
  new?: boolean;
  expires?: string;
  expiresAt?: string;
}

interface ArchiveGroup {
  update: string;
  codes: CodeEntry[];
}

interface Props {
  title: string;
  description: string;
  updated: string;
  nextUpdate?: string;
  type?: string;
  patch?: string;
  activeCodes?: CodeEntry[];
  expiredCodes?: CodeEntry[];
  archivedByUpdate?: ArchiveGroup[];
  /** When true, show the English-body fallback notice (non-default locale). */
  showFallbackNotice?: boolean;
}

const {
  title,
  description,
  updated,
  type,
  patch,
  activeCodes = [],
  expiredCodes = [],
  archivedByUpdate = [],
  showFallbackNotice = false,
} = Astro.props;

const locale = localeFromPath(Astro.url.pathname);
const ui = getUi(locale);
const dateLocale = LOCALE_BCP47[locale];

const updatedLabel = new Date(updated + 'T12:00:00').toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const relatedTypes = new Set([
  'hub',
  'codes',
  'tier-list',
  'beginner',
  'returning',
  'traits',
  'trait-odds',
  'summon-pity',
  'farm-rr',
  'lobby',
  'evolve',
  'event',
  'trading',
]);
const relatedCurrent = type && relatedTypes.has(type) ? type : 'guide';

const sourceContext =
  type === 'codes' ? 'codes' : type === 'tier-list' ? 'tier' : 'general';

const localeFaq = type === 'codes' ? ui.faq.codes : null;
const faqItems = localeFaq ?? ((type && FAQ_BY_TYPE[type]) || []);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  dateModified: updated,
  inLanguage: dateLocale,
  author: { '@type': 'Organization', name: 'AV Guides' },
  publisher: {
    '@type': 'Organization',
    name: 'AV Guides',
    url: 'https://animevanguards.co/',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).href,
  },
};
---

<BaseLayout title={title} description={description} type="article">
  <JsonLd data={articleLd} />

  <article class="prose">
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <span class="badge badge--trust">{ui.shared.lastChecked} {updatedLabel}</span>
        {
          type === 'codes' &&
            (activeCodes.length > 0 ? (
              <span class="badge badge--active">
                {activeCodes.length} {ui.codes.activeCount}
              </span>
            ) : (
              <span class="badge">{ui.codes.noActive}</span>
            ))
        }
        {
          (type === 'tier-list' || patch) && (
            <span class="badge">{patch ?? 'Update 14.x meta'}</span>
          )
        }
      </div>
      {
        type === 'codes' && (
          <p class="trust-line">
            {ui.codes.trustLine} {CODES_REFRESH_HOURS}
            {ui.codes.hours}
          </p>
        )
      }
    </header>

    {
      showFallbackNotice && locale !== defaultLocale && (
        <p class="callout fallback-notice" role="note">{ui.shared.englishFallback}</p>
      )
    }

    <SourceStrip context={sourceContext} />

    <AdSlot placement="leaderboard" />

    {
      type === 'codes' && (
        <section id="active-codes" aria-labelledby="active-heading">
          <h2 id="active-heading">{ui.codes.activeHeading}</h2>
          <p>{ui.codes.activeIntro}</p>
          {activeCodes.length > 0 ? (
            <CodeTable codes={activeCodes} copyAll tableId="active-codes-table" />
          ) : (
            <div class="callout callout--warn codes-empty" role="status">
              <strong>{ui.codes.noActiveListed}</strong>
              <p>{ui.codes.noActiveBody}:</p>
              <ul>
                <li>
                  <a
                    href="https://discord.com/invite/animevanguards"
                    rel="noopener noreferrer"
                    target="_blank">Official Discord</a
                  >{' '}
                  {ui.codes.discordFirst}
                </li>
                <li>
                  <a
                    href="https://wiki.vanguards.gg/Codes"
                    rel="noopener noreferrer"
                    target="_blank">Wiki Codes</a
                  >{' '}
                  {ui.codes.wikiFull}
                </li>
                <li>
                  <a href="#codes-archive">{ui.codes.archiveHeading}</a>{' '}
                  {ui.codes.archiveHint}
                </li>
              </ul>
            </div>
          )}
          <div class="after-redeem callout">
            <strong>{ui.codes.afterRedeem}</strong>
            <ol class="after-redeem__list">
              <li>
                {ui.codesAfter[0]}{' '}
                <a href={localizePath('/anime-vanguards/tier-list/', locale)}>tier</a>
                {' · '}
                <a href={localizePath('/anime-vanguards/traits/', locale)}>traits</a>
                {' · '}
                <a href={localizePath('/anime-vanguards/trait-reroll-odds/', locale)}>odds</a>
              </li>
              <li>
                {ui.codesAfter[1]}{' '}
                <a href={localizePath('/anime-vanguards/farm-trait-rerolls/', locale)}>farm</a>
                {' · '}
                <a href={localizePath('/anime-vanguards/lobby-guide/', locale)}>lobby</a>
              </li>
              <li>
                {ui.codesAfter[2]}{' '}
                <a href={localizePath('/anime-vanguards/beginner-guide/', locale)}>beginner</a>
                {' · '}
                <a href={localizePath('/anime-vanguards/returning-guide/', locale)}>returning</a>
              </li>
              <li>
                {ui.codesAfter[3]}{' '}
                <a href={localizePath('/anime-vanguards/event/', locale)}>event</a>
              </li>
            </ol>
          </div>
        </section>
      )
    }

    <AdSlot placement="in-article" />

    <div class="guide-body">
      <slot />
    </div>

    {
      type === 'codes' && archivedByUpdate.length > 0 && (
        <CodesArchive groups={archivedByUpdate} />
      )
    }

    {
      type === 'codes' &&
        archivedByUpdate.length === 0 &&
        expiredCodes.length > 0 && (
          <section id="expired-codes" aria-labelledby="expired-heading">
            <h2 id="expired-heading">{ui.codes.expiredHeading}</h2>
            <p>{ui.codes.expiredIntro}</p>
            <CodeTable codes={expiredCodes} showNew={false} tableId="expired-codes-table" />
          </section>
        )
    }

    {faqItems.length > 0 && <Faq items={faqItems} />}

    <RelatedGuides current={relatedCurrent} />

    <AdSlot placement="footer" />
  </article>
</BaseLayout>
