---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import CodeTable from '../components/CodeTable.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import JsonLd from '../components/JsonLd.astro';

interface CodeEntry {
  code: string;
  rewards: string;
  requirement?: string;
  new?: boolean;
}

interface Props {
  title: string;
  description: string;
  updated: string;
  type?: string;
  activeCodes?: CodeEntry[];
  expiredCodes?: CodeEntry[];
}

const {
  title,
  description,
  updated,
  type,
  activeCodes = [],
  expiredCodes = [],
} = Astro.props;

const updatedLabel = new Date(updated + 'T12:00:00').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const relatedTypes = new Set([
  'hub',
  'codes',
  'tier-list',
  'beginner',
  'traits',
  'evolve',
  'event',
]);
const relatedCurrent = type && relatedTypes.has(type) ? type : 'guide';

const codesFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do Anime Vanguards codes expire?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Most event and milestone codes expire after a short window. Redeem as soon as you can.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are Anime Vanguards codes case-sensitive?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Usually yes. Use the Copy button and paste exactly into the in-game Codes panel.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why doesn’t an Anime Vanguards code work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Common reasons: already redeemed, expired, wrong spelling, level requirement not met, or an old server. Rejoin a fresh server and try again.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this codes list official?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. This is an unofficial fan site. Codes originate from the developers; we aggregate them for faster redeeming.',
      },
    },
  ],
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  dateModified: updated,
  author: { '@type': 'Organization', name: 'AV Guides' },
  publisher: { '@type': 'Organization', name: 'AV Guides', url: 'https://animevanguards.co/' },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).href,
  },
};
---

<BaseLayout title={title} description={description} type="article">
  <JsonLd data={articleLd} />
  {type === 'codes' && <JsonLd data={codesFaq} />}

  <article class="prose">
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <span class="badge badge--trust">Last checked {updatedLabel}</span>
        {
          type === 'codes' && (
            <span class="badge badge--accent">{activeCodes.length} active codes</span>
          )
        }
        {type === 'tier-list' && <span class="badge">Update 14.x meta</span>}
      </div>
      {
        type === 'codes' && (
          <p class="trust-line">
            Community-verified list · Redeem ASAP (codes expire) · Unofficial fan guide
          </p>
        )
      }
    </header>

    <AdSlot slot="leaderboard" />

    {
      type === 'codes' && (
        <section id="active-codes" aria-labelledby="active-heading">
          <h2 id="active-heading">Active Anime Vanguards codes</h2>
          <p>
            Tap <strong>Copy</strong> or <strong>Copy all active</strong>, then paste
            in-game. Codes are case-sensitive and often need Level 10 or 30.
          </p>
          <CodeTable
            codes={activeCodes}
            copyAll
            tableId="active-codes-table"
            emptyLabel="No active codes right now. Check back soon."
          />
          <div class="after-redeem callout">
            <strong>After you redeem</strong>
            <ol class="after-redeem__list">
              <li>
                Put free Trait Rerolls on a unit you will actually main — see the{' '}
                <a href="/anime-vanguards/tier-list/">tier list</a> and{' '}
                <a href="/anime-vanguards/traits/">traits guide</a>.
              </li>
              <li>
                New account? Follow the{' '}
                <a href="/anime-vanguards/beginner-guide/">beginner path</a> before
                spending gems.
              </li>
              <li>
                Playing a limited mode? Read the{' '}
                <a href="/anime-vanguards/event/">event playbook</a>.
              </li>
            </ol>
          </div>
        </section>
      )
    }

    <AdSlot slot="in-article" />

    <div class="guide-body">
      <slot />
    </div>

    {
      type === 'codes' && expiredCodes.length > 0 && (
        <section id="expired-codes" aria-labelledby="expired-heading">
          <h2 id="expired-heading">Expired codes</h2>
          <p>These no longer work. Listed so you can avoid wasting time.</p>
          <CodeTable codes={expiredCodes} showNew={false} tableId="expired-codes-table" />
        </section>
      )
    }

    <RelatedGuides current={relatedCurrent} />

    <AdSlot slot="footer" />
  </article>
</BaseLayout>
