---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import CodeTable from '../components/CodeTable.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import JsonLd from '../components/JsonLd.astro';
import SourceStrip from '../components/SourceStrip.astro';
import CodesArchive from '../components/CodesArchive.astro';
import Faq from '../components/Faq.astro';
import { FAQ_BY_TYPE } from '../data/faqs';
import {
  CODES_REFRESH_HOURS,
  formatNextUpdateBadge,
  getNextUpdateDate,
} from '../lib/next-update';

interface CodeEntry {
  code: string;
  rewards: string;
  requirement?: string;
  new?: boolean;
  expires?: string;
  expiresAt?: string;
}

interface ArchiveGroup {
  update: string;
  codes: CodeEntry[];
}

interface Props {
  title: string;
  description: string;
  updated: string;
  /** ISO datetime for planned next refresh (codes) */
  nextUpdate?: string;
  type?: string;
  patch?: string;
  activeCodes?: CodeEntry[];
  expiredCodes?: CodeEntry[];
  archivedByUpdate?: ArchiveGroup[];
}

const {
  title,
  description,
  updated,
  nextUpdate,
  type,
  patch,
  activeCodes = [],
  expiredCodes = [],
  archivedByUpdate = [],
} = Astro.props;

const updatedLabel = new Date(updated + 'T12:00:00').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const codesNextDate =
  type === 'codes' ? getNextUpdateDate(updated, nextUpdate, CODES_REFRESH_HOURS) : null;
const codesNextBadge = codesNextDate ? formatNextUpdateBadge(codesNextDate) : null;
const codesNextIso = codesNextDate?.toISOString() ?? null;

const relatedTypes = new Set([
  'hub',
  'codes',
  'tier-list',
  'beginner',
  'returning',
  'traits',
  'trait-odds',
  'summon-pity',
  'farm-rr',
  'lobby',
  'evolve',
  'event',
  'trading',
]);
const relatedCurrent = type && relatedTypes.has(type) ? type : 'guide';

const sourceContext =
  type === 'codes' ? 'codes' : type === 'tier-list' ? 'tier' : 'general';

const faqItems = (type && FAQ_BY_TYPE[type]) || [];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  dateModified: updated,
  author: { '@type': 'Organization', name: 'AV Guides' },
  publisher: {
    '@type': 'Organization',
    name: 'AV Guides',
    url: 'https://animevanguards.co/',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).href,
  },
};
---

<BaseLayout title={title} description={description} type="article">
  <JsonLd data={articleLd} />

  <article class="prose">
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <span class="badge badge--trust">Last checked {updatedLabel}</span>
        {
          type === 'codes' &&
            codesNextBadge &&
            codesNextIso && (
              <span class="badge badge--next">
                <time datetime={codesNextIso}>{codesNextBadge}</time>
              </span>
            )
        }
        {
          type === 'codes' &&
            (activeCodes.length > 0 ? (
              <span class="badge badge--active">{activeCodes.length} active codes</span>
            ) : (
              <span class="badge">No active codes</span>
            ))
        }
        {
          (type === 'tier-list' || patch) && (
            <span class="badge">{patch ?? 'Update 14.x meta'}</span>
          )
        }
      </div>
      {
        type === 'codes' && (
          <p class="trust-line">
            Fast redeem list · Cross-check Wiki/Discord · Unofficial fan guide · Re-check every{' '}
            {CODES_REFRESH_HOURS}h
          </p>
        )
      }
    </header>

    <SourceStrip context={sourceContext} />

    <AdSlot placement="leaderboard" />

    {
      type === 'codes' && (
        <section id="active-codes" aria-labelledby="active-heading">
          <h2 id="active-heading">Active Anime Vanguards codes</h2>
          <p>
            Tap <strong>Copy</strong> or <strong>Copy all active</strong>, then paste
            in-game. Codes are case-sensitive and often need Level 10 or 30.
          </p>
          {activeCodes.length > 0 ? (
            <CodeTable codes={activeCodes} copyAll tableId="active-codes-table" />
          ) : (
            <div class="callout callout--warn codes-empty" role="status">
              <strong>No active codes listed right now</strong>
              <p>
                Lists often go empty between patch drops. Check these sources, then come
                back after the next announcement
                {codesNextBadge && codesNextIso && (
                  <>
                    {' '}
                    (planned site re-check:{' '}
                    <time datetime={codesNextIso}>{codesNextBadge.replace(/^Next update /, '')}</time>
                    , {CODES_REFRESH_HOURS}h after last sync)
                  </>
                )}
                :
              </p>
              <ul>
                <li>
                  <a
                    href="https://discord.com/invite/animevanguards"
                    rel="noopener noreferrer"
                    target="_blank">Official Discord</a
                  >{' '}
                  — codes usually drop here first
                </li>
                <li>
                  <a
                    href="https://wiki.vanguards.gg/Codes"
                    rel="noopener noreferrer"
                    target="_blank">Wiki Codes</a
                  >{' '}
                  — full archive &amp; live list
                </li>
                <li>
                  <a href="#codes-archive">Archive below</a> — recently expired codes so
                  you do not re-try dead ones
                </li>
              </ul>
            </div>
          )}
          <div class="after-redeem callout">
            <strong>After you redeem</strong>
            <ol class="after-redeem__list">
              <li>
                Put free Trait Rerolls on a unit you will actually main — see the{' '}
                <a href="/anime-vanguards/tier-list/">tier list</a>,{' '}
                <a href="/anime-vanguards/traits/">traits guide</a>, and{' '}
                <a href="/anime-vanguards/trait-reroll-odds/">reroll odds</a>.
              </li>
              <li>
                Need more RR after codes? Follow the{' '}
                <a href="/anime-vanguards/farm-trait-rerolls/">farm guide</a>. Reroll at{' '}
                <a href="/anime-vanguards/lobby-guide/">Mandra in the lobby</a>.
              </li>
              <li>
                New account? Follow the{' '}
                <a href="/anime-vanguards/beginner-guide/">beginner path</a>. Back
                after a break? Use the{' '}
                <a href="/anime-vanguards/returning-guide/">returning path</a>.
              </li>
              <li>
                Playing a limited mode? Read the{' '}
                <a href="/anime-vanguards/event/">event shop order</a>.
              </li>
            </ol>
          </div>
        </section>
      )
    }

    <AdSlot placement="in-article" />

    <div class="guide-body">
      <slot />
    </div>

    {
      type === 'codes' && archivedByUpdate.length > 0 && (
        <CodesArchive groups={archivedByUpdate} />
      )
    }

    {
      type === 'codes' &&
        archivedByUpdate.length === 0 &&
        expiredCodes.length > 0 && (
          <section id="expired-codes" aria-labelledby="expired-heading">
            <h2 id="expired-heading">Expired codes</h2>
            <p>These no longer work. Listed so you can avoid wasting time.</p>
            <CodeTable codes={expiredCodes} showNew={false} tableId="expired-codes-table" />
          </section>
        )
    }

    {faqItems.length > 0 && <Faq items={faqItems} />}

    <RelatedGuides current={relatedCurrent} />

    <AdSlot placement="footer" />
  </article>
</BaseLayout>
