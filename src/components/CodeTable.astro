---
import { getUi } from '../i18n/ui';
import { localeFromPath } from '../lib/url';

interface CodeEntry {
  code: string;
  rewards: string;
  requirement?: string;
  new?: boolean;
  expires?: string;
  expiresAt?: string;
}

interface Props {
  codes: CodeEntry[];
  emptyLabel?: string;
  showNew?: boolean;
  copyAll?: boolean;
  /** Show copy button column (default true) */
  showCopy?: boolean;
  tableId?: string;
}

const ui = getUi(localeFromPath(Astro.url.pathname));
const {
  codes,
  emptyLabel = ui.codes.empty,
  showNew = true,
  copyAll = false,
  showCopy = true,
  tableId = 'codes-table',
} = Astro.props;

const allCodesPayload = codes.map((c) => c.code).join('\n');
const showExpires = true;
---

{
  codes.length === 0 ? (
    <p class="callout">{emptyLabel}</p>
  ) : (
    <>
      {copyAll && (
        <div class="codes-toolbar">
          <span class="badge">{ui.shared.copyAllHint}</span>
          <button
            type="button"
            class="btn btn--primary copy-all-btn"
            data-codes={allCodesPayload}
            data-count={String(codes.length)}
            data-label-copied={ui.shared.copiedAll}
            data-toast={ui.shared.copiedAllToast}
            aria-label={ui.shared.copyAll}
          >
            {ui.shared.copyAll}
          </button>
        </div>
      )}
      <div class="codes-table-wrap">
        <table class="codes-table" id={tableId}>
          <thead>
            <tr>
              <th>{ui.codes.colCode}</th>
              <th>{ui.codes.colRewards}</th>
              <th>{ui.codes.colReq}</th>
              {showExpires && <th>{ui.codes.colExpires}</th>}
              {showCopy && <th></th>}
            </tr>
          </thead>
          <tbody>
            {codes.map((row) => {
              const expired =
                row.expires?.toLowerCase().includes('expired') ||
                (row.expiresAt
                  ? new Date(row.expiresAt + 'T23:59:59') < new Date()
                  : false);
              return (
                <tr class:list={[expired && 'codes-table__row--expired']}>
                  <td>
                    <span class="code-cell">{row.code}</span>
                    {showNew && row.new && (
                      <span class="badge badge--new" style="margin-left:0.4rem">
                        {ui.shared.new}
                      </span>
                    )}
                  </td>
                  <td>{row.rewards}</td>
                  <td class="req">{row.requirement ?? '—'}</td>
                  {showExpires && (
                    <td class:list={['expires', expired && 'expires--past']}>
                      {row.expires ?? (row.expiresAt ? row.expiresAt : '—')}
                    </td>
                  )}
                  {showCopy && (
                    <td>
                      <button
                        type="button"
                        class="btn btn--primary copy-btn"
                        data-code={row.code}
                        data-label-copy={ui.shared.copy}
                        data-label-copied={ui.shared.copied}
                        data-toast={ui.shared.copiedToast}
                        aria-label={`${ui.shared.copy} ${row.code}`}
                      >
                        {ui.shared.copy}
                      </button>
                    </td>
                  )}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="copy-hint" id="copy-toast" hidden role="status" aria-live="polite" />
    </>
  )
}

<script>
  declare function gtag(...args: unknown[]): void;

  function track(name: string, params: Record<string, unknown>) {
    try {
      if (typeof gtag === 'function') gtag('event', name, params);
    } catch {
      /* ignore */
    }
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        return true;
      } catch {
        return false;
      }
    }
  }

  function flashButton(btn: HTMLButtonElement, okLabel: string) {
    const prev = btn.textContent;
    btn.textContent = okLabel;
    btn.classList.add('is-copied');
    setTimeout(() => {
      btn.textContent = prev;
      btn.classList.remove('is-copied');
    }, 1600);
  }

  function showToast(msg: string) {
    const el = document.getElementById('copy-toast');
    if (!el) return;
    el.hidden = false;
    el.textContent = msg;
    window.setTimeout(() => {
      el.hidden = true;
    }, 4000);
  }

  function bindCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const code = btn.dataset.code ?? '';
        const ok = await copyText(code);
        if (ok) {
          flashButton(btn, btn.dataset.labelCopied || 'Copied');
          track('copy_code', { code_name: code });
          showToast(btn.dataset.toast || '');
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.copy-all-btn').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const codes = btn.dataset.codes ?? '';
        const count = Number(btn.dataset.count ?? '0');
        const ok = await copyText(codes);
        if (ok) {
          flashButton(btn, btn.dataset.labelCopied || 'Copied');
          track('copy_all', { code_count: count });
          showToast(`${count} ${btn.dataset.toast || ''}`.trim());
        }
      });
    });
  }

  bindCopyButtons();
  document.addEventListener('astro:page-load', bindCopyButtons);
</script>
