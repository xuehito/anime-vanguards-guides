---
import { getUi } from '../i18n/ui';
import { localeFromPath, localizePath } from '../lib/url';

interface Link {
  href: string;
  title: string;
  blurb: string;
  tag?: string;
}

interface Props {
  current?: string;
  heading?: string;
}

const locale = localeFromPath(Astro.url.pathname);
const ui = getUi(locale);
const { current, heading = ui.related.heading } = Astro.props;
const r = ui.related;

const relatedHrefs: Record<string, string> = {
  codes: '/anime-vanguards/codes/',
  beginner: '/anime-vanguards/beginner-guide/',
  returning: '/anime-vanguards/returning-guide/',
  'tier-list': '/anime-vanguards/tier-list/',
  traits: '/anime-vanguards/traits/',
  'trait-odds': '/anime-vanguards/trait-reroll-odds/',
  'summon-pity': '/anime-vanguards/summon-pity/',
  'farm-rr': '/anime-vanguards/farm-trait-rerolls/',
  lobby: '/anime-vanguards/lobby-guide/',
  trading: '/anime-vanguards/trading/',
  evolve: '/anime-vanguards/evolve/',
  event: '/anime-vanguards/event/',
  hub: '/anime-vanguards/',
};

const all: (Link & { id: string })[] = Object.entries(relatedHrefs).map(([id, href]) => {
  const copy = r[id as keyof typeof r] as { title: string; blurb: string; tag: string };
  return {
    id,
    href: localizePath(href, locale),
    title: copy.title,
    blurb: copy.blurb,
    tag: copy.tag,
  };
});

const preference: Record<string, string[]> = {
  codes: ['farm-rr', 'returning', 'traits'],
  beginner: ['lobby', 'codes', 'farm-rr'],
  returning: ['codes', 'farm-rr', 'event'],
  'tier-list': ['traits', 'trait-odds', 'summon-pity'],
  traits: ['trait-odds', 'farm-rr', 'trading'],
  'trait-odds': ['summon-pity', 'farm-rr', 'traits'],
  'summon-pity': ['tier-list', 'trait-odds', 'codes'],
  'farm-rr': ['trait-odds', 'codes', 'returning'],
  lobby: ['farm-rr', 'traits', 'trading'],
  trading: ['returning', 'farm-rr', 'lobby'],
  evolve: ['lobby', 'traits', 'tier-list'],
  event: ['codes', 'farm-rr', 'returning'],
  hub: ['codes', 'summon-pity', 'tier-list'],
  guide: ['codes', 'returning', 'farm-rr'],
};

const order = preference[current ?? 'guide'] ?? preference.guide;
const byId = Object.fromEntries(all.map((l) => [l.id, l]));
const links = order.map((id) => byId[id]).filter(Boolean).filter((l) => l.id !== current);
---

{
  links.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">{heading}</h2>
      <div class="card-grid related__grid">
        {links.map((l) => (
          <a class="card related-link" href={l.href} data-related={l.id}>
            <h3 class="related__title">{l.title}</h3>
            <p>{l.blurb}</p>
            {l.tag && <span class="tag">{l.tag}</span>}
          </a>
        ))}
      </div>
    </section>
  )
}

<script>
  function trackRelated() {
    document.querySelectorAll<HTMLAnchorElement>('a.related-link').forEach((a) => {
      if (a.dataset.gaBound) return;
      a.dataset.gaBound = '1';
      a.addEventListener('click', () => {
        const id = a.dataset.related ?? 'unknown';
        // @ts-expect-error gtag optional
        if (typeof gtag === 'function') {
          // @ts-expect-error gtag
          gtag('event', 'click_related', {
            related_id: id,
            link_url: a.href,
          });
        }
      });
    });
  }
  trackRelated();
  document.addEventListener('astro:page-load', trackRelated);
</script>
