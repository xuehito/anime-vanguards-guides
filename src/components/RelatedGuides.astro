---
interface Link {
  href: string;
  title: string;
  blurb: string;
  tag?: string;
}

interface Props {
  current?: string;
  heading?: string;
}

const { current, heading = 'Continue your session' } = Astro.props;

const all: (Link & { id: string })[] = [
  {
    id: 'codes',
    href: '/anime-vanguards/codes/',
    title: 'Working codes',
    blurb: 'Copy free Trait Rerolls, Gems, and event rewards.',
    tag: 'Fast',
  },
  {
    id: 'beginner',
    href: '/anime-vanguards/beginner-guide/',
    title: 'Beginner path',
    blurb: 'First hours: what to farm, what not to waste.',
    tag: 'New players',
  },
  {
    id: 'tier-list',
    href: '/anime-vanguards/tier-list/',
    title: 'Unit tier list',
    blurb: 'Who to invest gems and Trait Rerolls into.',
    tag: 'Meta',
  },
  {
    id: 'traits',
    href: '/anime-vanguards/traits/',
    title: 'Traits & rerolls',
    blurb: 'Where free code rerolls should go first.',
    tag: 'Power',
  },
  {
    id: 'trait-odds',
    href: '/anime-vanguards/trait-reroll-odds/',
    title: 'Reroll odds calculator',
    blurb: 'How many RR for a chase trait — planning math.',
    tag: 'Tools',
  },
  {
    id: 'trading',
    href: '/anime-vanguards/trading/',
    title: 'Trading guide',
    blurb: 'Rules, WFL checklist, trait loss, scam safety.',
    tag: 'Trade',
  },
  {
    id: 'evolve',
    href: '/anime-vanguards/evolve/',
    title: 'Evolution priority',
    blurb: 'Who to evolve before you farm for a week.',
    tag: 'Progress',
  },
  {
    id: 'event',
    href: '/anime-vanguards/event/',
    title: 'Event playbook',
    blurb: 'Limited content order: free rewards first.',
    tag: 'Limited',
  },
  {
    id: 'hub',
    href: '/anime-vanguards/',
    title: 'Game hub',
    blurb: 'All Anime Vanguards guides in one place.',
    tag: 'Hub',
  },
];

const preference: Record<string, string[]> = {
  codes: ['trait-odds', 'traits', 'tier-list'],
  beginner: ['codes', 'traits', 'tier-list'],
  'tier-list': ['traits', 'trait-odds', 'codes'],
  traits: ['trait-odds', 'codes', 'tier-list'],
  'trait-odds': ['traits', 'codes', 'trading'],
  trading: ['tier-list', 'trait-odds', 'codes'],
  evolve: ['traits', 'tier-list', 'event'],
  event: ['codes', 'tier-list', 'traits'],
  hub: ['codes', 'trait-odds', 'trading'],
  guide: ['codes', 'trait-odds', 'trading'],
};

const order = preference[current ?? 'guide'] ?? preference.guide;
const byId = Object.fromEntries(all.map((l) => [l.id, l]));
const links = order.map((id) => byId[id]).filter(Boolean).filter((l) => l.id !== current);
---

{
  links.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">{heading}</h2>
      <div class="card-grid related__grid">
        {links.map((l) => (
          <a class="card related-link" href={l.href} data-related={l.id}>
            <h3 class="related__title">{l.title}</h3>
            <p>{l.blurb}</p>
            {l.tag && <span class="tag">{l.tag}</span>}
          </a>
        ))}
      </div>
    </section>
  )
}

<script>
  function trackRelated() {
    document.querySelectorAll<HTMLAnchorElement>('a.related-link').forEach((a) => {
      if (a.dataset.gaBound) return;
      a.dataset.gaBound = '1';
      a.addEventListener('click', () => {
        const id = a.dataset.related ?? 'unknown';
        // @ts-expect-error gtag optional
        if (typeof gtag === 'function') {
          // @ts-expect-error gtag
          gtag('event', 'click_related', {
            related_id: id,
            link_url: a.href,
          });
        }
      });
    });
  }
  trackRelated();
  document.addEventListener('astro:page-load', trackRelated);
</script>
