---
/**
 * Patch + "what to do this week" — inspired by wiki home / official changelog.
 */
import { getUi } from '../i18n/ui';
import { localeFromPath, localizePath } from '../lib/url';

interface Props {
  version?: string;
  versionNote?: string;
}

const locale = localeFromPath(Astro.url.pathname);
const ui = getUi(locale);
const {
  version = 'Update 14.5',
  versionNote = '25th Hour / The Arcana — redeem codes, then clear limited event rewards',
} = Astro.props;

const hot = ui.version.items;
---

<section class="version-hot" aria-labelledby="version-hot-heading">
  <div class="version-hot__banner">
    <div>
      <p class="version-hot__kicker">{ui.version.kicker}</p>
      <h2 id="version-hot-heading" class="version-hot__title">{version}</h2>
      <p class="version-hot__note">{versionNote}</p>
    </div>
    <div class="version-hot__official">
      <a
        class="btn"
        href="https://vanguards.gg/changelog"
        rel="noopener noreferrer"
        target="_blank">{ui.version.changelog}</a
      >
      <a
        class="btn"
        href="https://wiki.vanguards.gg/Anime_Vanguards_Wiki"
        rel="noopener noreferrer"
        target="_blank">{ui.version.wikiHome}</a
      >
    </div>
  </div>
  <p class="version-hot__hot-label">{ui.version.hot}</p>
  <ul class="version-hot__grid">
    {
      hot.map((h) => (
        <li>
          <a class="version-hot__card" href={localizePath(h.href, locale)}>
            <span class="tag">{h.tag}</span>
            <span class="version-hot__card-title">{h.title}</span>
            <span class="version-hot__card-blurb">{h.blurb}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
