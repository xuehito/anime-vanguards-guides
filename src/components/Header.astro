---
import { getUi } from '../i18n/ui';
import { localeFromPath, localizePath, stripLocalePrefix } from '../lib/url';
import LanguageSwitcher from './LanguageSwitcher.astro';

const path = Astro.url.pathname;
const locale = localeFromPath(path);
const ui = getUi(locale);
const bare = stripLocalePrefix(path);

const links = [
  { href: '/anime-vanguards/codes/', label: ui.nav.codes },
  { href: '/anime-vanguards/tier-list/', label: ui.nav.tier },
  { href: '/anime-vanguards/summon-pity/', label: ui.nav.pity },
  { href: '/anime-vanguards/trait-reroll-odds/', label: ui.nav.rerolls },
  { href: '/blog/', label: ui.nav.blog },
  { href: '/anime-vanguards/', label: ui.nav.more },
];

function isCurrent(href: string) {
  if (href === '/anime-vanguards/') {
    return (
      bare === '/anime-vanguards/' ||
      bare === '/anime-vanguards' ||
      bare.includes('/evolve') ||
      bare.includes('/event') ||
      bare.includes('/beginner') ||
      bare.includes('/returning') ||
      bare.includes('/traits/') ||
      bare.includes('/farm-') ||
      bare.includes('/lobby') ||
      bare.includes('/trading')
    );
  }
  if (href === '/blog/') {
    return bare === '/blog/' || bare.startsWith('/blog/');
  }
  return bare === href || bare.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="logo" href={localizePath('/', locale)}>AV <span>Guides</span></a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="sr-only">{ui.nav.menu}</span>
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>
    <nav class="nav" id="site-nav" data-nav aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={localizePath(l.href, locale)}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <LanguageSwitcher locale={locale} />
    </nav>
  </div>
</header>

<script>
  function bindNav() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!toggle || !nav || toggle.dataset.bound) return;
    toggle.dataset.bound = '1';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      nav.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });

    nav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 721px)').matches) setOpen(false);
    });
  }

  bindNav();
  document.addEventListener('astro:page-load', bindNav);
</script>
