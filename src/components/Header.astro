---
const path = Astro.url.pathname;

const links = [
  { href: '/anime-vanguards/codes/', label: 'Codes' },
  { href: '/anime-vanguards/tier-list/', label: 'Tier' },
  { href: '/anime-vanguards/summon-pity/', label: 'Pity' },
  { href: '/anime-vanguards/trait-reroll-odds/', label: 'Rerolls' },
  { href: '/blog/', label: 'Blog' },
  { href: '/anime-vanguards/', label: 'More' },
];

function isCurrent(href: string) {
  if (href === '/anime-vanguards/') {
    return (
      path === '/anime-vanguards/' ||
      path === '/anime-vanguards' ||
      path.includes('/evolve') ||
      path.includes('/event') ||
      path.includes('/beginner') ||
      path.includes('/returning') ||
      path.includes('/traits/') ||
      path.includes('/farm-') ||
      path.includes('/lobby') ||
      path.includes('/trading')
    );
  }
  if (href === '/blog/') {
    return path === '/blog/' || path.startsWith('/blog/');
  }
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="logo" href="/">AV <span>Guides</span></a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>
    <nav class="nav" id="site-nav" data-nav aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  function bindNav() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!toggle || !nav || toggle.dataset.bound) return;
    toggle.dataset.bound = '1';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      nav.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });

    nav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    // Close when resizing back to desktop nav
    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 721px)').matches) setOpen(false);
    });
  }

  bindNav();
  document.addEventListener('astro:page-load', bindNav);
</script>
