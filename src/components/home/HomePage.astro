---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../AdSlot.astro';
import VersionHotBar from '../VersionHotBar.astro';
import SourceStrip from '../SourceStrip.astro';
import CodeTable from '../CodeTable.astro';
import SummonPityCalculator from '../SummonPityCalculator.astro';
import { localeFromPath, localizePath } from '../../lib/url';
import { LOCALE_BCP47 } from '../../i18n/routing';
import { getUi } from '../../i18n/ui';
import { site } from '../../config/site';

const locale = localeFromPath(Astro.url.pathname);
const ui = getUi(locale);
const dateLocale = LOCALE_BCP47[locale];

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate))
  .slice(0, 3);

const codesEntry = await getEntry('guides', 'anime-vanguards-codes');
const activeCodes = codesEntry?.data.activeCodes ?? [];
const codesUpdated = codesEntry?.data.updated ?? '1970-01-01';
const HOME_CODES_PREVIEW = 5;
const previewCodes = activeCodes.slice(0, HOME_CODES_PREVIEW);
const hasMoreCodes = activeCodes.length > HOME_CODES_PREVIEW;

const latestUpdated = guides.reduce((max, g) => {
  return g.data.updated > max ? g.data.updated : max;
}, '1970-01-01');

const latestLabel = new Date(latestUpdated + 'T12:00:00').toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const codesUpdatedLabel = new Date(codesUpdated + 'T12:00:00').toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const cards = guides.map((g) => {
  const slug = g.id.replace(/\.mdx?$/, '');
  const href =
    slug === 'anime-vanguards'
      ? '/anime-vanguards/'
      : `/anime-vanguards/${slug.replace(/^anime-vanguards-/, '')}/`;
  return {
    href: localizePath(href, locale),
    title: g.data.label ?? g.data.title,
    description: g.data.description,
    tag: g.data.type,
    updated: g.data.updated,
  };
});

const startPath = ui.home.path;
---

<BaseLayout title={ui.home.metaTitle} description={ui.home.metaDescription} wide>
  <section class="hero prose">
    <p class="eyebrow">
      <span class="badge badge--trust">{ui.shared.updated} {latestLabel}</span>
      <span class="badge">{ui.site.unofficial}</span>
      <span class="badge">{ui.site.wikiSync}</span>
    </p>
    <h1>{ui.home.title}</h1>
    <p>{ui.home.lead}</p>
    <div class="hero__cta">
      <a
        class="btn btn--primary hero-cta-link"
        href={localizePath('/anime-vanguards/codes/', locale)}
        data-cta="codes"
      >
        {ui.home.ctaCodes}
      </a>
      <a
        class="btn hero-cta-link"
        href={localizePath('/anime-vanguards/summon-pity/', locale)}
        data-cta="pity"
      >
        {ui.home.ctaPity}
      </a>
      <a
        class="btn hero-cta-link"
        href={site.social.roblox}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="play"
      >
        {ui.home.ctaPlay}
      </a>
    </div>
  </section>

  <VersionHotBar
    version="Update 14.5"
    versionNote="25th Hour / The Arcana — redeem codes, clear free event rewards, then invest rerolls."
  />

  <SourceStrip context="general" />

  <section class="home-codes" id="codes" aria-labelledby="home-codes-heading">
    <div class="home-codes__head">
      <div>
        <h2 id="home-codes-heading" class="section-title" style="margin-bottom:0.35rem">
          {ui.codes.homeHeading}
        </h2>
        <p class="home-codes__meta">
          {
            activeCodes.length > 0 ? (
              <>
                <span class="badge badge--active">
                  {activeCodes.length} {ui.codes.activeCount}
                </span>
                <span class="badge badge--trust">
                  {ui.codes.checked} {codesUpdatedLabel}
                </span>
              </>
            ) : (
              <>
                <span class="badge">{ui.codes.noneLive}</span>
                <span class="badge badge--trust">
                  {ui.codes.checked} {codesUpdatedLabel}
                </span>
              </>
            )
          }
        </p>
      </div>
      <a class="btn" href={localizePath('/anime-vanguards/codes/', locale)}>{ui.codes.homeFull}</a>
    </div>

    {
      activeCodes.length > 0 ? (
        <>
          <CodeTable
            codes={previewCodes}
            copyAll={activeCodes.length <= HOME_CODES_PREVIEW}
            tableId="home-codes-table"
          />
          {hasMoreCodes && (
            <p class="home-codes__more">
              {HOME_CODES_PREVIEW} / {activeCodes.length}.{' '}
              <a href={localizePath('/anime-vanguards/codes/', locale)}>{ui.codes.homeSeeAll}</a>
            </p>
          )}
          {!hasMoreCodes && (
            <p class="home-codes__more">
              <a href={localizePath('/anime-vanguards/codes/', locale)}>{ui.codes.homeHowTo}</a>
            </p>
          )}
        </>
      ) : (
        <div class="callout callout--warn codes-empty" role="status">
          <strong>{ui.codes.homeNone}</strong>
          <p>
            {ui.codes.homeNoneBody}{' '}
            <a
              href="https://discord.com/invite/animevanguards"
              rel="noopener noreferrer"
              target="_blank"
            >
              Discord
            </a>
            {' / '}
            <a href="https://wiki.vanguards.gg/Codes" rel="noopener noreferrer" target="_blank">
              Wiki
            </a>
            {' · '}
            <a href={localizePath('/anime-vanguards/codes/', locale) + '#codes-archive'}>
              {ui.codes.archiveHeading}
            </a>
          </p>
        </div>
      )
    }
  </section>

  <AdSlot placement="leaderboard" live={true} enabled={true} />

  <section class="home-tools" aria-labelledby="home-tools-heading">
    <div class="home-tools__head">
      <h2 id="home-tools-heading" class="section-title" style="margin-bottom:0.35rem">
        {ui.home.tools}
      </h2>
      <p class="home-tools__meta">{ui.home.toolsMeta}</p>
    </div>
    <SummonPityCalculator compact id="home-summon-pity" />
    <p class="home-tools__more">
      <a href={localizePath('/anime-vanguards/trait-reroll-odds/', locale)}>{ui.home.rerollOdds}</a>
      {' · '}
      <a href={localizePath('/anime-vanguards/tier-list/', locale)}>{ui.home.tierList}</a>
    </p>
  </section>

  <section class="start-here" aria-labelledby="start-heading">
    <div class="start-here__head">
      <h2 id="start-heading">{ui.home.startHere}</h2>
      <p>{ui.home.startLead}</p>
    </div>
    <ol class="path-grid">
      {
        startPath.map((p) => (
          <li>
            <a
              class="path-card start-path-link"
              href={localizePath(p.href, locale)}
              data-path={p.id}
            >
              <span class="path-card__step">{p.step}</span>
              <span class="path-card__title">{p.title}</span>
              <span class="path-card__blurb">{p.blurb}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="all-guides-heading">
    <h2 id="all-guides-heading" class="section-title">{ui.home.allGuides}</h2>
    <div class="card-grid">
      {
        cards.map((c) => (
          <a class="card" href={c.href}>
            <h2>{c.title}</h2>
            <p>{c.description}</p>
            <span class="tag">{c.tag}</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="home-blog" aria-labelledby="latest-blog-heading">
        <div class="home-blog__head">
          <div>
            <h2 id="latest-blog-heading" class="section-title">
              {ui.home.latestBlog}
            </h2>
            <p>{ui.home.latestBlogLead}</p>
          </div>
          <a class="btn" href={localizePath('/blog/', locale)}>
            {ui.home.allPosts}
          </a>
        </div>
        <div class="blog-list blog-list--home">
          {latestPosts.map((post) => {
            const slug = post.id.replace(/\.mdx?$/, '');
            const dateLabel = new Date(post.data.pubDate + 'T12:00:00').toLocaleDateString(
              dateLocale,
              {
                month: 'short',
                day: 'numeric',
              },
            );

            return (
              <article class="blog-card">
                <a href={localizePath(`/blog/${slug}/`, locale)}>
                  <div class="blog-card__meta">
                    <span>{post.data.category}</span>
                    <time datetime={post.data.pubDate}>{dateLabel}</time>
                  </div>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="prose" style="margin-top: 2.5rem">
    <h2>{ui.home.why}</h2>
    <ul>
      <li>{ui.home.whyCodes}</li>
      <li>{ui.home.whyTier}</li>
      <li>{ui.home.whyMobile}</li>
    </ul>
    <p class="callout">{ui.home.notAffiliated}</p>
  </section>
</BaseLayout>

<script>
  function bindStartPath() {
    document.querySelectorAll<HTMLAnchorElement>('a.start-path-link').forEach((a) => {
      if (a.dataset.gaBound) return;
      a.dataset.gaBound = '1';
      a.addEventListener('click', () => {
        const id = a.dataset.path ?? 'unknown';
        // @ts-expect-error gtag optional
        if (typeof gtag === 'function') {
          // @ts-expect-error gtag
          gtag('event', 'click_start_path', { path_id: id });
        }
      });
    });
  }

  function bindHeroCta() {
    document.querySelectorAll<HTMLAnchorElement>('a.hero-cta-link').forEach((a) => {
      if (a.dataset.gaBound) return;
      a.dataset.gaBound = '1';
      a.addEventListener('click', () => {
        const cta = a.dataset.cta ?? 'unknown';
        // @ts-expect-error gtag optional
        if (typeof gtag === 'function') {
          // @ts-expect-error gtag
          gtag('event', 'click_hero_cta', { cta_id: cta });
        }
      });
    });
  }

  bindStartPath();
  bindHeroCta();
  document.addEventListener('astro:page-load', () => {
    bindStartPath();
    bindHeroCta();
  });
</script>
