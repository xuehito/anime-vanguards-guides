---
/**
 * Compatibility wrapper around AnvilWiki-style iframe ads.
 *
 * Hidden unless:
 *   - PUBLIC_ADS_ENABLED=true and the slot has a key, or
 *   - `live` / `enabled` is true and the slot has a key
 *
 * Homepage keeps the existing 728×90 unit via ads.ts fallback key.
 */
import { isSlotOn, slotFromPlacement } from '../config/ads';
import { getUi } from '../i18n/ui';
import { localeFromPath } from '../lib/url';
import AdBanner from './ads/AdBanner.astro';

interface Props {
  placement: 'leaderboard' | 'in-article' | 'footer' | 'sidebar';
  live?: boolean;
  enabled?: boolean;
}

const { placement, live = false, enabled = false } = Astro.props;
const slot = slotFromPlacement(placement);
const show = isSlotOn(slot, { live, enabled });
const locale = localeFromPath(Astro.url.pathname);
const ui = getUi(locale);
---

{
  show && (
    <aside
      class:list={[
        'ad-slot',
        `ad-slot--${placement}`,
        'ad-slot--iframe',
      ]}
      data-ad-slot={placement}
      data-live={live ? 'true' : 'false'}
      aria-label={ui.ads.label}
    >
      <span class="ad-slot__label">{ui.ads.label}</span>
      <AdBanner type={slot} eager={live || placement === 'leaderboard'} />
    </aside>
  )
}
