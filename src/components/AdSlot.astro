---
/**
 * Reserved ad slot for future AdSense / Mediavine.
 * Set ADS_ENABLED=true and wire script in BaseLayout when ready.
 *
 * Placement tips:
 * - leaderboard: under H1 / above codes table
 * - in-article: after first H2
 * - footer: end of article
 */
interface Props {
  slot: 'leaderboard' | 'in-article' | 'footer' | 'sidebar';
  /** When true, hides placeholder label (use once ads are live) */
  live?: boolean;
}

const { slot, live = false } = Astro.props;
const labels: Record<Props['slot'], string> = {
  leaderboard: 'Ad · Leaderboard',
  'in-article': 'Ad · In-article',
  footer: 'Ad · Footer',
  sidebar: 'Ad · Sidebar',
};
---

<aside
  class:list={[
    'ad-slot',
    slot === 'leaderboard' && 'ad-slot--leaderboard',
    slot === 'in-article' && 'ad-slot--in-article',
    slot === 'footer' && 'ad-slot--footer',
  ]}
  data-ad-slot={slot}
  data-live={live ? 'true' : 'false'}
  aria-hidden="true"
>
  {!live && labels[slot]}
  <!--
    Future: paste AdSense <ins> here, e.g.
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-XXXX"
         data-ad-slot="YYYY" data-ad-format="auto" data-full-width-responsive="true"></ins>
  -->
</aside>
