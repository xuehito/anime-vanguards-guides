---
/**
 * Authority sources — learn from official wiki/site, stay the decision layer.
 */
interface Props {
  /** Highlight context: codes | tier | general */
  context?: 'codes' | 'tier' | 'general';
}

const { context = 'general' } = Astro.props;

const links = [
  {
    href: 'https://discord.com/invite/animevanguards',
    label: 'Official Discord',
    note: 'Codes drop first',
    show: true,
  },
  {
    href: 'https://wiki.vanguards.gg/Codes',
    label: 'Wiki Codes',
    note: 'Full archive',
    show: context === 'codes' || context === 'general',
  },
  {
    href: 'https://wiki.vanguards.gg/Tier_List',
    label: 'Wiki Tier List',
    note: 'Authority meta',
    show: context === 'tier' || context === 'general',
  },
  {
    href: 'https://vanguards.gg/changelog',
    label: 'Official Changelog',
    note: 'What shipped',
    show: true,
  },
  {
    href: 'https://wiki.vanguards.gg/Anime_Vanguards_Wiki',
    label: 'Official Wiki',
    note: 'Unit data',
    show: context === 'general',
  },
].filter((l) => l.show);
---

<aside class="source-strip" aria-label="Official sources">
  <p class="source-strip__label">Sources (authoritative)</p>
  <ul class="source-strip__list">
    {
      links.map((l) => (
        <li>
          <a href={l.href} rel="noopener noreferrer" target="_blank">
            <span class="source-strip__name">{l.label}</span>
            <span class="source-strip__note">{l.note}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="source-strip__foot">
    Unofficial fan guides — we help you <strong>act</strong> (redeem, invest, path). Data &amp; patch
    truth live on Wiki / Discord / Changelog.
  </p>
</aside>
