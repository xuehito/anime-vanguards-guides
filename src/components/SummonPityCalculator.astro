---
/**
 * Banner / summon gem budget planner (hard pity model).
 * Presets are planning defaults — re-check in-game banner rates.
 */
import { BANNER_PRESETS, WIKI_HOME_URL } from '../data/banners';

interface Props {
  /** Compact layout for homepage embed */
  compact?: boolean;
  id?: string;
}

const { compact = false, id = 'summon-pity-calculator' } = Astro.props;

const presetsJson = JSON.stringify(
  BANNER_PRESETS.map((b) => ({
    id: b.id,
    name: b.name,
    rate: b.rate,
    pity: b.pity ?? null,
    gemsPerPull: b.gemsPerPull,
    summary: b.summary,
  })),
);
---

<section
  class:list={['calc', 'calc--summon', compact && 'calc--compact']}
  id={id}
  aria-labelledby={`${id}-heading`}
>
  <h2 id={`${id}-heading`}>{compact ? 'Summon pity planner' : 'Summon pity calculator'}</h2>
  <p class="calc__disclaimer">
    Plan gem budgets for a <strong>target unit</strong> (or rate-up slot). Presets are
    <strong> planning estimates</strong> — set Custom when you know the real rate / pity from the
    banner UI or{' '}
    <a href={WIKI_HOME_URL} rel="noopener noreferrer" target="_blank">official Wiki</a>. Hard pity
    model matches our trait calculator.
  </p>

  <form class="calc__form" id={`${id}-form`} data-summon-form>
    <div class="calc__field">
      <label for={`${id}-preset`}>Banner / target preset</label>
      <select id={`${id}-preset`} name="preset" data-field="preset">
        {
          BANNER_PRESETS.map((b, i) => (
            <option value={b.id} selected={i === 0}>
              {b.name}
              {' — '}
              {(b.rate * 100).toFixed(b.rate < 0.01 ? 2 : 1)}%
              {b.pity ? ` · pity ${b.pity}` : ''}
            </option>
          ))
        }
        <option value="custom">Custom rate…</option>
      </select>
    </div>

    <p class="calc__trait-summary" data-field="summary" />

    <div class="calc__grid-2">
      <div class="calc__field" data-custom-only hidden>
        <label for={`${id}-rate`}>Chance per pull (%)</label>
        <input
          id={`${id}-rate`}
          name="rate"
          type="number"
          min="0.01"
          max="50"
          step="0.01"
          value="0.5"
          inputmode="decimal"
          data-field="rate"
        />
      </div>
      <div class="calc__field" data-custom-only hidden>
        <label for={`${id}-pity`}>Hard pity (0 = none)</label>
        <input
          id={`${id}-pity`}
          name="pity"
          type="number"
          min="0"
          max="5000"
          step="1"
          value="100"
          inputmode="numeric"
          data-field="pity"
        />
      </div>
    </div>

    <div class="calc__grid-2">
      <div class="calc__field">
        <label for={`${id}-gems`}>Gems you have (budget)</label>
        <input
          id={`${id}-gems`}
          name="gems"
          type="number"
          min="0"
          max="10000000"
          step="1"
          value="5000"
          inputmode="numeric"
          data-field="gems"
        />
      </div>
      <div class="calc__field">
        <label for={`${id}-cost`}>Gems per pull</label>
        <input
          id={`${id}-cost`}
          name="cost"
          type="number"
          min="1"
          max="10000"
          step="1"
          value="50"
          inputmode="numeric"
          data-field="cost"
        />
      </div>
    </div>

    <div class="calc__field">
      <label for={`${id}-progress`}>Pity progress already (optional)</label>
      <input
        id={`${id}-progress`}
        name="progress"
        type="number"
        min="0"
        max="5000"
        step="1"
        value="0"
        inputmode="numeric"
        data-field="progress"
      />
    </div>

    <button type="submit" class="btn btn--primary calc__submit">Calculate</button>
  </form>

  <div class="calc__results" data-results hidden>
    <h3 class="calc__results-title">Results</h3>
    <ul class="calc__stats">
      <li>
        <span class="calc__stat-label">Pulls in budget</span>
        <span class="calc__stat-value" data-out="pulls">—</span>
      </li>
      <li>
        <span class="calc__stat-label">Chance of ≥1 hit</span>
        <span class="calc__stat-value" data-out="chance">—</span>
      </li>
      <li>
        <span class="calc__stat-label">Expected pulls to first hit</span>
        <span class="calc__stat-value" data-out="expected">—</span>
      </li>
      <li>
        <span class="calc__stat-label">Expected gems</span>
        <span class="calc__stat-value" data-out="expected-gems">—</span>
      </li>
      <li>
        <span class="calc__stat-label">Pulls for ~50% / ~90%</span>
        <span class="calc__stat-value" data-out="p50-p90">—</span>
      </li>
      <li>
        <span class="calc__stat-label">Gems for ~50% / ~90%</span>
        <span class="calc__stat-value" data-out="gems-band">—</span>
      </li>
      <li>
        <span class="calc__stat-label">Pulls / gems until pity</span>
        <span class="calc__stat-value" data-out="pity-left">—</span>
      </li>
    </ul>
    <p class="calc__note" data-out="note"></p>
    {
      !compact ? (
        <p class="calc__next">
          After the pull plan:{' '}
          <a href="/anime-vanguards/tier-list/">tier list</a>
          {' · '}
          <a href="/anime-vanguards/trait-reroll-odds/">trait odds</a>
          {' · '}
          <a href="/anime-vanguards/codes/">codes</a>
          {' · '}
          <a href="/anime-vanguards/farm-trait-rerolls/">farm RR</a>
        </p>
      ) : (
        <p class="calc__next">
          <a href="/anime-vanguards/summon-pity/">Full summon pity page →</a>
          {' · '}
          <a href="/anime-vanguards/tier-list/">Who to pull for</a>
        </p>
      )
    }
  </div>
</section>

<script define:vars={{ presetsJson, rootId: id }}>
  const PRESETS = JSON.parse(presetsJson);

  function clamp(n, lo, hi) {
    return Math.min(hi, Math.max(lo, n));
  }

  function rollsForChance(p, target, pity) {
    if (p <= 0 || p >= 1) return Infinity;
    let n = Math.ceil(Math.log(1 - target) / Math.log(1 - p));
    if (pity && pity > 0) n = Math.min(n, pity);
    return n;
  }

  function expectedWithPity(p, pity) {
    if (p <= 0) return Infinity;
    if (!pity || pity <= 0) return 1 / p;
    let e = 0;
    const q = 1 - p;
    for (let k = 1; k < pity; k++) {
      e += k * p * Math.pow(q, k - 1);
    }
    e += pity * Math.pow(q, pity - 1);
    return e;
  }

  function chanceAtLeastOne(p, n, pity, progress) {
    if (p <= 0 || n <= 0) return 0;
    const pityLeft = pity && pity > 0 ? Math.max(1, pity - Math.max(0, progress)) : null;
    if (pityLeft !== null && n >= pityLeft) return 1;
    return 1 - Math.pow(1 - p, n);
  }

  function formatPct(x) {
    if (!Number.isFinite(x)) return '—';
    if (x >= 0.9995) return '≥99.95% (or pity)';
    if (x < 0.0001) return '<0.01%';
    return `${(x * 100).toFixed(2)}%`;
  }

  function formatInt(n) {
    if (!Number.isFinite(n) || n > 1e12) return '—';
    return Math.round(n).toLocaleString('en-US');
  }

  function root() {
    return document.getElementById(rootId);
  }

  function q(sel) {
    return root()?.querySelector(sel);
  }

  function getSelection() {
    const presetEl = q('[data-field="preset"]');
    const id = presetEl?.value || PRESETS[0].id;
    if (id === 'custom') {
      const raw = Number(q('[data-field="rate"]')?.value);
      const pity = Math.floor(Number(q('[data-field="pity"]')?.value) || 0);
      return {
        id: 'custom',
        name: 'Custom',
        rate: clamp(raw / 100, 0.00001, 0.5),
        pity: pity > 0 ? pity : null,
        gemsPerPull: clamp(Math.floor(Number(q('[data-field="cost"]')?.value) || 50), 1, 10000),
        summary: 'Custom rate',
      };
    }
    const b = PRESETS.find((x) => x.id === id) || PRESETS[0];
    return {
      ...b,
      gemsPerPull: clamp(
        Math.floor(Number(q('[data-field="cost"]')?.value) || b.gemsPerPull),
        1,
        10000,
      ),
    };
  }

  function updateSummary() {
    const isCustom = q('[data-field="preset"]')?.value === 'custom';
    root()?.querySelectorAll('[data-custom-only]').forEach((el) => {
      el.hidden = !isCustom;
    });
    const t = getSelection();
    const summary = q('[data-field="summary"]');
    if (summary) {
      summary.textContent = isCustom
        ? 'Enter rate, optional hard pity, and gems per pull from the banner UI.'
        : t.summary;
    }
    if (!isCustom && t.gemsPerPull) {
      const cost = q('[data-field="cost"]');
      if (cost && !cost.dataset.touched) cost.value = String(t.gemsPerPull);
    }
  }

  function runCalc(e) {
    if (e) e.preventDefault();
    const t = getSelection();
    const p = t.rate;
    const pity = t.pity;
    const cost = clamp(Math.floor(Number(q('[data-field="cost"]')?.value) || 50), 1, 10000);
    const gems = clamp(Math.floor(Number(q('[data-field="gems"]')?.value) || 0), 0, 10000000);
    const progress = clamp(
      Math.floor(Number(q('[data-field="progress"]')?.value) || 0),
      0,
      pity || 5000,
    );
    const pulls = Math.floor(gems / cost);
    const atLeastOne = chanceAtLeastOne(p, pulls, pity, progress);
    const expected = expectedWithPity(p, pity);
    const p50 = rollsForChance(p, 0.5, pity);
    const p90 = rollsForChance(p, 0.9, pity);
    const pityLeft = pity ? Math.max(0, pity - progress) : null;

    const results = q('[data-results]');
    if (results) results.hidden = false;

    const set = (key, val) => {
      const el = q(`[data-out="${key}"]`);
      if (el) el.textContent = val;
    };

    set('pulls', `${formatInt(pulls)} (${formatInt(gems)} gems ÷ ${cost})`);
    set('chance', formatPct(atLeastOne));
    set('expected', `~${formatInt(expected)}`);
    set('expected-gems', `~${formatInt(expected * cost)}`);
    set('p50-p90', `~${formatInt(p50)} / ~${formatInt(p90)}`);
    set('gems-band', `~${formatInt(p50 * cost)} / ~${formatInt(p90 * cost)}`);
    set(
      'pity-left',
      pityLeft === null
        ? 'No hard pity in model'
        : pityLeft === 0
          ? 'Pity ready'
          : `${formatInt(pityLeft)} pulls · ~${formatInt(pityLeft * cost)} gems`,
    );

    const note = q('[data-out="note"]');
    if (note) {
      note.textContent = `${t.name}: p = ${(p * 100).toFixed(3)}% per pull${
        pity ? `, hard pity ${pity}` : ''
      }, budget ${formatInt(gems)} gems → ${formatInt(pulls)} pulls. Planning model only.`;
    }

    try {
      if (typeof gtag === 'function') {
        gtag('event', 'summon_pity_calc', {
          preset: t.id,
          rate: p,
          pity: pity || 0,
          gems,
          pulls,
        });
      }
    } catch (_) {}
  }

  function bind() {
    const form = q('[data-summon-form]');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    const preset = q('[data-field="preset"]');
    const cost = q('[data-field="cost"]');
    preset?.addEventListener('change', () => {
      if (cost) delete cost.dataset.touched;
      updateSummary();
      runCalc();
    });
    cost?.addEventListener('input', () => {
      cost.dataset.touched = '1';
    });
    form.addEventListener('submit', runCalc);
    form.querySelectorAll('input').forEach((inp) => {
      inp.addEventListener('change', () => runCalc());
    });
    updateSummary();
    runCalc();
  }

  bind();
  document.addEventListener('astro:page-load', bind);
</script>
