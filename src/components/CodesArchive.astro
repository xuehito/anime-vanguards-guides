---
interface CodeEntry {
  code: string;
  rewards: string;
  requirement?: string;
  expires?: string;
  expiresAt?: string;
}

interface ArchiveGroup {
  update: string;
  codes: CodeEntry[];
}

interface Props {
  groups: ArchiveGroup[];
}

const { groups } = Astro.props;

function expiresLabel(row: CodeEntry) {
  if (row.expires) return row.expires;
  if (row.expiresAt) {
    try {
      return (
        'Expired · ' +
        new Date(row.expiresAt + 'T12:00:00').toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
        })
      );
    } catch {
      return `Expired · ${row.expiresAt}`;
    }
  }
  return 'Expired';
}
---

{
  groups.length > 0 && (
    <section id="codes-archive" class="codes-archive" aria-labelledby="archive-heading">
      <h2 id="archive-heading">Archived by update</h2>
      <p>
        Expired or historical codes. Check the <strong>Expires</strong> column so you know when a
        code died — not for re-redeeming.
      </p>
      {groups.map((g, i) => (
        <details class="archive-group" open={i === 0}>
          <summary>
            <span class="archive-group__title">{g.update}</span>
            <span class="badge">{g.codes.length} codes</span>
          </summary>
          <div class="codes-table-wrap">
            <table class="codes-table">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Rewards</th>
                  <th>Req.</th>
                  <th>Expires</th>
                </tr>
              </thead>
              <tbody>
                {g.codes.map((row) => (
                  <tr class="codes-table__row--expired">
                    <td>
                      <span class="code-cell">{row.code}</span>
                    </td>
                    <td>{row.rewards}</td>
                    <td class="req">{row.requirement ?? '—'}</td>
                    <td class="expires expires--past">{expiresLabel(row)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}
      <p class="archive-more">
        Full historical list:{' '}
        <a href="https://wiki.vanguards.gg/Codes" rel="noopener noreferrer" target="_blank">
          wiki.vanguards.gg/Codes
        </a>
      </p>
    </section>
  )
}
